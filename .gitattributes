# Consistent repository line endings on Windows and other systems
* text=auto eol=lf
*.cs text eol=lf diff=csharp
*.shader text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.json text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.inputactions text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
# Unity YAML stays in normal Git, never LFS
*.meta text eol=lf whitespace=-blank-at-eol
*.unity text eol=lf whitespace=-blank-at-eol merge=unityyamlmerge
*.prefab text eol=lf whitespace=-blank-at-eol merge=unityyamlmerge
*.asset text eol=lf whitespace=-blank-at-eol merge=unityyamlmerge
*.mat text eol=lf whitespace=-blank-at-eol merge=unityyamlmerge
*.anim text eol=lf whitespace=-blank-at-eol merge=unityyamlmerge
*.controller text eol=lf whitespace=-blank-at-eol merge=unityyamlmerge
*.overrideController text eol=lf whitespace=-blank-at-eol merge=unityyamlmerge
*.playable text eol=lf whitespace=-blank-at-eol merge=unityyamlmerge
*.mask text eol=lf whitespace=-blank-at-eol merge=unityyamlmerge
*.renderTexture text eol=lf whitespace=-blank-at-eol merge=unityyamlmerge
*.terrainlayer text eol=lf whitespace=-blank-at-eol merge=unityyamlmerge
