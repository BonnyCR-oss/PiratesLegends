#screen { position: absolute; left: 0; right: 0; top: 0; bottom: 0; color: rgb(234, 240, 246); }
#selector { flex-grow: 1; }
.panel { width: 470px; height: 100%; padding: 24px 32px 18px 32px; background-color: rgba(12, 20, 30, 0.97); border-right-width: 1px; border-right-color: rgba(126, 160, 186, 0.28); }
.eyebrow { color: rgb(140, 162, 182); font-size: 10px; letter-spacing: 1.4px; margin-bottom: 10px; }
.title { font-size: 38px; -unity-font-style: bold; line-height: 40px; margin-bottom: 8px; }
.subtitle { font-size: 13px; color: rgb(158, 178, 195); white-space: normal; margin-bottom: 14px; }
#cards { flex-direction: row; flex-wrap: wrap; margin-left: -4px; margin-right: -4px; }
.character-card { width: 47%; height: 92px; margin: 4px; padding: 11px 12px; align-items: flex-start; background-color: rgb(23, 35, 48); border-width: 1px; border-color: rgb(53, 70, 86); border-left-width: 3px; border-radius: 6px; color: rgb(235, 242, 248); }
.character-card:hover { background-color: rgb(35, 51, 66); }
.character-card.selected { background-color: rgb(37, 55, 71); border-top-color: rgb(158, 189, 208); border-right-color: rgb(158, 189, 208); border-bottom-color: rgb(158, 189, 208); }
.character-card:disabled { opacity: 0.38; }
#number { font-size: 11px; color: rgb(156, 178, 196); }
.card-name { font-size: 22px; -unity-font-style: bold; margin-top: 3px; }
.card-status { font-size: 9px; letter-spacing: 1px; margin-top: 6px; color: rgb(171, 193, 209); }
.details { margin-top: 14px; flex-grow: 1; }
.selected-name { font-size: 25px; -unity-font-style: bold; margin-bottom: 6px; }
.description { white-space: normal; font-size: 13px; color: rgb(200, 214, 226); margin-bottom: 6px; }
.controls { white-space: normal; font-size: 11px; color: rgb(148, 174, 192); }
#play { height: 48px; background-color: rgb(214, 179, 105); color: rgb(21, 27, 32); -unity-font-style: bold; font-size: 13px; border-width: 0; border-radius: 5px; margin: 10px 0 12px 0; }
#play:hover { background-color: rgb(239, 208, 141); }
.footer { white-space: normal; font-size: 10px; color: rgb(133, 154, 173); }
.preview-tag { position: absolute; right: 26px; top: 26px; font-size: 10px; letter-spacing: 1px; color: rgb(218, 231, 240); background-color: rgba(12, 20, 30, 0.8); padding: 10px 14px; border-radius: 4px; }
#hud { position: absolute; left: 22px; right: 22px; top: 22px; flex-direction: row; justify-content: space-between; align-items: center; display: none; }
#hud-name { white-space: normal; max-width: 75%; background-color: rgba(12, 20, 30, 0.88); padding: 12px 18px; font-size: 12px; border-radius: 4px; }
#change { background-color: rgb(23, 35, 48); color: rgb(235, 242, 248); padding: 12px; border-color: rgb(86, 110, 131); border-radius: 4px; }
